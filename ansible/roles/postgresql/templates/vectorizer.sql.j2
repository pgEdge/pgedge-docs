-- pgEdge Vectorizer Configuration
-- Managed by Ansible - do not edit manually
--
-- This configures pgedge-vectorizer to create embeddings for the docs table

-- Enable vectorization on the docs table content column
-- This will:
--   1. Create a chunks table (docs_content_chunks) with an embedding column
--   2. Automatically chunk and vectorize content when rows are inserted/updated
--   3. Use background workers to generate embeddings asynchronously
SELECT pgedge_vectorizer.enable_vectorization(
    source_table := 'public.docs',
    source_column := 'content',
    chunk_strategy := 'token_based',
    chunk_size := {{ vectorizer_chunk_size }},
    chunk_overlap := {{ vectorizer_chunk_overlap }}
);

-- Grant permissions on the chunks table to RAG user
-- Full permissions needed because docloader triggers create chunks
GRANT SELECT, INSERT, UPDATE, DELETE ON public.docs_content_chunks TO {{ pg_user }};
GRANT USAGE, SELECT, UPDATE ON public.docs_content_chunks_id_seq TO {{ pg_user }};

-- Grant permissions on the pgedge_vectorizer schema (for trigger functions)
GRANT USAGE ON SCHEMA pgedge_vectorizer TO {{ pg_user }};
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA pgedge_vectorizer TO {{ pg_user }};
GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA pgedge_vectorizer TO {{ pg_user }};
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA pgedge_vectorizer TO {{ pg_user }};
