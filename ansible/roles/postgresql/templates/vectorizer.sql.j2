-- pgEdge Vectorizer Configuration
-- Managed by Ansible - do not edit manually
--
-- This configures pgedge-vectorizer to create embeddings for the docs table

-- Enable the vectorizer extension
CREATE EXTENSION IF NOT EXISTS vectorizer;

-- Create vectorizer for the docs table
-- This will:
--   1. Add an 'embedding' column to the docs table
--   2. Automatically generate embeddings for new/updated rows
--   3. Use the configured embedding model
SELECT vectorizer.create(
    -- Source table to vectorize
    source_table => 'public.docs',

    -- Column containing text to embed
    source_column => 'content',

    -- Embedding configuration
    embedding => vectorizer.embedding_openai(
        model => '{{ vectorizer_embedding_model }}',
        dimensions => {{ vectorizer_embedding_dimensions }}
    ),

    -- Chunking configuration (content is already chunked, so minimal chunking)
    chunking => vectorizer.chunking_character_text_splitter(
        chunk_size => {{ vectorizer_chunk_size }},
        chunk_overlap => {{ vectorizer_chunk_overlap }},
        separator => E'\n\n'
    ),

    -- Formatting template - include metadata in the embedded text
    formatting => vectorizer.formatting_python_template(
        template => '{{ vectorizer_template }}'
    ),

    -- Schedule for processing (how often to check for new content)
    scheduling => vectorizer.scheduling_timescaledb(
        interval => '{{ vectorizer_schedule_interval }}'::interval
    )
);

-- Grant permissions on the embedding column to RAG user
-- (The vectorizer creates additional structures that need permissions)
GRANT SELECT ON ALL TABLES IN SCHEMA public TO {{ pg_user }};
