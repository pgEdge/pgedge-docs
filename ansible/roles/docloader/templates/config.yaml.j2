# =============================================================================
# pgEdge Docloader Configuration
# =============================================================================
#
# Managed by Ansible - changes made on the server are overwritten on deploy.
#
# What Ellie loads is decided by the documentation site's mkdocs.yml, not by
# this file: load-docs reads the site's nav on every run and loads each
# section at the version the site treats as latest, and removes documents the
# site no longer publishes. To add, bump or remove a product, change
# mkdocs.yml (usually through the sync-mkdocs PR from pgedge-doc-sources).
#
# Only content the site does not publish is listed here, under extra_sources.
#
# Usage: Run 'sudo load-docs' to process all sources
#
# =============================================================================

# Directory for storing downloaded/cloned documentation
data_dir: "{{ docloader_data_dir }}"

# Database connection
database:
  host: {{ docloader_db_host }}
  port: {{ docloader_db_port }}
  name: {{ docloader_db_name }}
  user: {{ docloader_db_user }}
  password_file: {{ docloader_config_dir }}/.pgpass
  sslmode: {{ docloader_db_sslmode }}
  table: {{ docloader_db_table }}

# Column mappings (match the docs table schema)
columns:
  title: {{ docloader_col_title }}
  content: {{ docloader_col_content }}
  filename: {{ docloader_col_filename }}
  row_created: created_at
  row_updated: updated_at

# =============================================================================
# Documentation Site (source of truth)
# =============================================================================
site:
  git_url: "{{ docloader_site_git_url }}"
  git_ref: "{{ docloader_site_git_ref }}"
  mkdocs_file: "{{ docloader_site_mkdocs_file }}"

# Removing documents the site no longer publishes. A run that would remove
# more than max_fraction of all documents stops instead, unless load-docs is
# given --force-prune; that guards against a broken or truncated nav.
prune:
  max_fraction: {{ docloader_prune_max_fraction }}

# =============================================================================
# Extra Sources (content the site does not publish)
# =============================================================================
#
# Local path options:
#   local_path: Local directory path
#   doc_path: Glob pattern within path for docs (optional)
#
# Git repository options:
#   git_url: URL to fetch
#   git_ref: Branch or tag to check out (default: HEAD)
#   doc_path: Glob pattern within repo for docs (e.g., "docs/**/*.md")
#
# Metadata (mapped to custom columns):
#   product: Product name (required)
#   version: Version string (optional)
#
# Supported document formats: Markdown (.md), HTML (.html, .htm),
# reStructuredText (.rst), DocBook SGML (.sgml, .sgm) and XML (.xml). All are
# converted to Markdown for storage, and the pgedge-vectorizer extension
# generates embeddings for new and changed rows.
#
# =============================================================================

extra_sources:
  # -------------------------------------------------------------------------
  # Website Content (crawled by crawl-website)
  # -------------------------------------------------------------------------
  - local_path: "{{ docloader_data_dir }}/websites/pgedge-website"
    doc_path: "*.md"
    product: "pgEdge Website"
    version: ""

  # -------------------------------------------------------------------------
  # Package Availability (generated by scan-packages)
  # -------------------------------------------------------------------------
  - local_path: "{{ docloader_data_dir }}/packages"
    doc_path: "*.md"
    product: "pgEdge Packages"
    version: ""

  # -------------------------------------------------------------------------
  # Internal Wiki (extracted by extract-wiki)
  # -------------------------------------------------------------------------
  - local_path: "{{ docloader_data_dir }}/wiki"
    doc_path: "*.md"
    product: "pgEdge Internal KB"
    version: ""
