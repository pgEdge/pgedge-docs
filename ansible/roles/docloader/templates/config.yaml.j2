# =============================================================================
# Notes
# =============================================================================
#
# Supported document formats:
#   - Markdown (.md)
#   - HTML (.html, .htm)
#   - reStructuredText (.rst)
#   - DocBook SGML (.sgml)
#   - DocBook XML (.xml)
#
# All formats are automatically converted to Markdown for storage.
#
# The pgedge-vectorizer extension will automatically generate embeddings
# for new/updated rows in the docs table.
#
# =============================================================================

  # -------------------------------------------------------------------------
  # Website Content (crawled by crawl-website)
  # -------------------------------------------------------------------------
  # Run 'sudo crawl-website' first to populate this directory
  - local_path: "{{ docloader_data_dir }}/websites/pgedge-website"
    doc_path: "*.md"
    product: "pgEdge Website"
    version: ""

  # -------------------------------------------------------------------------
  # Package Availability (generated by scan-packages)
  # -------------------------------------------------------------------------
  # Run 'sudo scan-packages' to generate/update the package list
  - local_path: "{{ docloader_data_dir }}/packages"
    doc_path: "*.md"
    product: "pgEdge Packages"
    version: ""

  # -------------------------------------------------------------------------
  # Internal Wiki (extracted by extract-wiki)
  # -------------------------------------------------------------------------
  # Run 'sudo extract-wiki' to extract content from Confluence
  - local_path: "{{ docloader_data_dir }}/wiki"
    doc_path: "*.md"
    product: "pgEdge Internal KB"
    version: ""
