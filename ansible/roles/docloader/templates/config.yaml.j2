# =============================================================================
# pgEdge Docloader Configuration
# =============================================================================
#
# This file configures documentation sources to load into the RAG database.
# Edit this file to add or remove documentation sources.
#
# NOTE: This file is NOT managed by Ansible after initial deployment.
# Your changes will be preserved across Ansible runs.
#
# Usage: Run 'sudo load-docs' to process all sources
#
# =============================================================================

# Directory for storing downloaded/cloned documentation
data_dir: "{{ docloader_data_dir }}"

# Database connection
database:
  host: {{ docloader_db_host }}
  port: {{ docloader_db_port }}
  name: {{ docloader_db_name }}
  user: {{ docloader_db_user }}
  password_file: {{ docloader_config_dir }}/.pgpass
  sslmode: {{ docloader_db_sslmode }}
  table: {{ docloader_db_table }}

# Column mappings (match the docs table schema)
columns:
  title: {{ docloader_col_title }}
  content: {{ docloader_col_content }}
  filename: {{ docloader_col_filename }}
  row_created: created_at
  row_updated: updated_at

# =============================================================================
# Documentation Sources
# =============================================================================
#
# Each source specifies a git repository or local path to load.
#
# Git repository options:
#   git_url: URL to clone (required for git sources)
#   git_tag: Specific tag to checkout, or "latest" to auto-detect newest tag
#   git_branch: Specific branch to checkout (default: main)
#   tag_prefix: Filter tags by prefix when using "latest" (e.g., "v", "REL_")
#   doc_path: Glob pattern within repo for docs (e.g., "docs/**/*.md")
#
# Local path options:
#   local_path: Local directory path
#   doc_path: Glob pattern within path for docs
#
# Metadata (mapped to custom columns):
#   product: Product name (required)
#   version: Version string (optional)
#
# =============================================================================

sources:
  # -------------------------------------------------------------------------
  # PostgreSQL Core Documentation
  # -------------------------------------------------------------------------
  - git_url: "https://github.com/postgres/postgres.git"
    git_tag: "REL_18_1"
    doc_path: "doc/src/sgml/*.sgml"
    product: "PostgreSQL"
    version: "18"

  - git_url: "https://github.com/postgres/postgres.git"
    git_tag: "REL_17_7"
    doc_path: "doc/src/sgml/*.sgml"
    product: "PostgreSQL"
    version: "17"

  - git_url: "https://github.com/postgres/postgres.git"
    git_tag: "REL_16_11"
    doc_path: "doc/src/sgml/*.sgml"
    product: "PostgreSQL"
    version: "16"

  # -------------------------------------------------------------------------
  # pgEdge Products Documentation
  # -------------------------------------------------------------------------
