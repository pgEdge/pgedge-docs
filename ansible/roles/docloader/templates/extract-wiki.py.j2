#!/usr/bin/env python3
# =============================================================================
# extract-wiki - Extract Confluence wiki pages to markdown
# =============================================================================
#
# This script extracts pages from the pgEdge internal Confluence wiki and
# converts them to markdown for loading into the RAG database.
#
# Usage:
#   sudo extract-wiki                    # Extract all wiki pages
#   sudo extract-wiki --dry-run          # Show what would be extracted
#
# Configuration:
#   Credentials are read from {{ docloader_config_dir }}/.atlassian
#
# Output: {{ docloader_data_dir }}/wiki/
# =============================================================================

import os
import sys
import re
import argparse
from pathlib import Path
from urllib.parse import urljoin

try:
    import requests
except ImportError:
    print("Error: requests is required. Install with: pip install requests", file=sys.stderr)
    sys.exit(1)

try:
    import html2text
except ImportError:
    print("Error: html2text is required. Install with: pip install html2text", file=sys.stderr)
    sys.exit(1)

# Configuration
CONFLUENCE_URL = "{{ docloader_wiki_url | default('https://pgedge.atlassian.net') }}"
SPACE_KEY = "{{ docloader_wiki_space | default('KB') }}"
PARENT_PAGE_ID = "{{ docloader_wiki_parent_page | default('61571365') }}"
OUTPUT_DIR = "{{ docloader_data_dir }}/wiki"
CREDENTIALS_FILE = "{{ docloader_config_dir }}/.atlassian"


def load_credentials() -> tuple[str, str]:
    """Load Atlassian credentials from file."""
    if not os.path.exists(CREDENTIALS_FILE):
        print(f"Error: Credentials file not found: {CREDENTIALS_FILE}", file=sys.stderr)
        print("\nCreate the file with two lines:", file=sys.stderr)
        print("  Line 1: Your Atlassian email", file=sys.stderr)
        print("  Line 2: Your API token", file=sys.stderr)
        print("\nTo create an API token:", file=sys.stderr)
        print("  1. Go to https://id.atlassian.com/manage-profile/security/api-tokens", file=sys.stderr)
        print("  2. Click 'Create API token'", file=sys.stderr)
        print("  3. Copy the token", file=sys.stderr)
        sys.exit(1)

    with open(CREDENTIALS_FILE, 'r') as f:
        lines = f.read().strip().split('\n')
        if len(lines) < 2:
            print(f"Error: Credentials file must contain email and API token on separate lines", file=sys.stderr)
            sys.exit(1)
        return lines[0].strip(), lines[1].strip()


class ConfluenceExporter:
    def __init__(self, base_url: str, email: str, api_token: str):
        self.base_url = base_url.rstrip("/")
        self.session = requests.Session()
        self.session.auth = (email, api_token)
        self.session.headers.update({"Accept": "application/json"})

        # Configure html2text for better markdown output
        self.h2t = html2text.HTML2Text()
        self.h2t.ignore_links = False
        self.h2t.ignore_images = False
        self.h2t.body_width = 0  # Don't wrap lines
        self.h2t.protect_links = True

    def get_page(self, page_id: str) -> dict:
        """Fetch a single page with its body content."""
        url = f"{self.base_url}/wiki/api/v2/pages/{page_id}"
        params = {"body-format": "storage"}  # Get the storage format (XHTML)

        resp = self.session.get(url, params=params)
        resp.raise_for_status()
        return resp.json()

    def get_child_pages(self, page_id: str) -> list[dict]:
        """Get all direct child pages of a given page."""
        children = []
        url = f"{self.base_url}/wiki/api/v2/pages/{page_id}/children"

        while url:
            resp = self.session.get(url)
            resp.raise_for_status()
            data = resp.json()

            children.extend(data.get("results", []))

            # Handle pagination
            links = data.get("_links", {})
            next_link = links.get("next")
            url = urljoin(self.base_url, next_link) if next_link else None

        return children

    def get_all_descendants(self, page_id: str, depth: int = 0) -> list[dict]:
        """Recursively get all descendant pages."""
        all_pages = []

        children = self.get_child_pages(page_id)
        for child in children:
            child["_depth"] = depth
            all_pages.append(child)

            # Recursively get grandchildren
            descendants = self.get_all_descendants(child["id"], depth + 1)
            all_pages.extend(descendants)

        return all_pages

    def convert_to_markdown(self, storage_content: str, page_title: str) -> str:
        """Convert Confluence storage format to markdown."""
        # Pre-process Confluence-specific macros
        content = self._preprocess_confluence_macros(storage_content)

        # Convert HTML to markdown
        markdown = self.h2t.handle(content)

        # Add title as H1
        markdown = f"# {page_title}\n\n{markdown}"

        # Remove Confluence anchor IDs from headings (e.g., "# _k0x4kml9xdiw" prefix)
        markdown = re.sub(r'^(#+\s*)_[a-z0-9]+', r'\1', markdown, flags=re.MULTILINE)

        # Clean up extra whitespace
        markdown = re.sub(r"\n{3,}", "\n\n", markdown)

        return markdown.strip()

    def _preprocess_confluence_macros(self, content: str) -> str:
        """Handle common Confluence macros before HTML conversion."""
        # Code blocks
        content = re.sub(
            r'<ac:structured-macro[^>]*ac:name="code"[^>]*>.*?'
            r'<ac:plain-text-body><!\[CDATA\[(.*?)\]\]></ac:plain-text-body>.*?'
            r'</ac:structured-macro>',
            r'```\n\1\n```',
            content,
            flags=re.DOTALL
        )

        # Info/note/warning panels
        for panel_type in ["info", "note", "warning", "tip"]:
            content = re.sub(
                rf'<ac:structured-macro[^>]*ac:name="{panel_type}"[^>]*>.*?'
                r'<ac:rich-text-body>(.*?)</ac:rich-text-body>.*?'
                r'</ac:structured-macro>',
                rf'> **{panel_type.upper()}**: \1',
                content,
                flags=re.DOTALL
            )

        # Remove other macros but keep their body content
        content = re.sub(
            r'<ac:structured-macro[^>]*>.*?<ac:rich-text-body>(.*?)</ac:rich-text-body>.*?</ac:structured-macro>',
            r'\1',
            content,
            flags=re.DOTALL
        )

        # Clean up remaining Confluence-specific tags
        content = re.sub(r'<ac:[^>]*/?>', '', content)
        content = re.sub(r'</ac:[^>]*>', '', content)
        content = re.sub(r'<ri:[^>]*/?>', '', content)
        content = re.sub(r'</ri:[^>]*>', '', content)

        return content

    def sanitize_filename(self, title: str) -> str:
        """Create a safe filename from a page title."""
        # Replace problematic characters
        filename = re.sub(r'[<>:"/\\|?*]', '-', title)
        filename = re.sub(r'\s+', '-', filename)
        filename = re.sub(r'-+', '-', filename)
        return filename.strip('-').lower()

    def export_pages(self, parent_page_id: str, output_dir: str, dry_run: bool = False):
        """Export all pages under a parent to markdown files."""
        output_path = Path(output_dir)

        print(f"Fetching page tree starting from {parent_page_id}...")

        # Get the parent page first
        parent = self.get_page(parent_page_id)
        parent["_depth"] = 0

        # Get all descendants
        all_pages = [parent] + self.get_all_descendants(parent_page_id, depth=1)

        print(f"Found {len(all_pages)} pages to export")

        if dry_run:
            print("\n--- Dry run - would export: ---\n")
            for page in all_pages:
                title = page["title"]
                depth = page.get("_depth", 0)
                filename = f"{self.sanitize_filename(title)}.md"
                print(f"{'  ' * depth}{title} -> {filename}")
            return

        output_path.mkdir(parents=True, exist_ok=True)

        # Create an index file
        index_content = "# pgEdge Knowledge Base\n\n"
        index_content += "This content is extracted from the internal pgEdge Confluence wiki.\n\n"

        for page in all_pages:
            page_id = page["id"]
            title = page["title"]
            depth = page.get("_depth", 0)

            print(f"{'  ' * depth}Exporting: {title}")

            # Fetch full page content
            full_page = self.get_page(page_id)

            # Get the body content
            body = full_page.get("body", {})
            storage = body.get("storage", {})
            content = storage.get("value", "")

            # Convert to markdown
            markdown = self.convert_to_markdown(content, title)

            # Create filename
            filename = f"{self.sanitize_filename(title)}.md"
            filepath = output_path / filename

            # Write the file
            filepath.write_text(markdown, encoding="utf-8")

            # Add to index
            indent = "  " * depth
            index_content += f"{indent}- [{title}]({filename})\n"

        # Write index file
        (output_path / "INDEX.md").write_text(index_content, encoding="utf-8")

        print(f"\nExported {len(all_pages)} pages to {output_dir}")


def main():
    parser = argparse.ArgumentParser(
        description='Extract Confluence wiki pages to markdown',
    )
    parser.add_argument('--dry-run', '-n', action='store_true',
                        help='Show what would be extracted without writing files')
    parser.add_argument('--output', '-o', default=OUTPUT_DIR,
                        help=f'Output directory (default: {OUTPUT_DIR})')
    parser.add_argument('--page-id', '-p', default=PARENT_PAGE_ID,
                        help=f'Parent page ID to start from (default: {PARENT_PAGE_ID})')

    args = parser.parse_args()

    # Load credentials
    email, api_token = load_credentials()

    print(f"Confluence URL: {CONFLUENCE_URL}")
    print(f"Starting from page: {args.page_id}")
    print(f"Output directory: {args.output}")

    exporter = ConfluenceExporter(CONFLUENCE_URL, email, api_token)
    exporter.export_pages(args.page_id, args.output, args.dry_run)


if __name__ == "__main__":
    main()
