#!/usr/bin/env python3
# =============================================================================
# scan-packages - Scan pgEdge repositories for available packages
# =============================================================================
#
# This script queries the pgEdge apt and dnf repositories to generate a
# markdown document listing all available packages. This document is then
# loaded into the RAG database to give Ellie accurate package information.
#
# Usage:
#   sudo scan-packages              # Generate package list
#   sudo scan-packages --dry-run    # Show what would be generated
#
# Output: {{ docloader_data_dir }}/packages/pgedge-packages.md
# =============================================================================

import os
import sys
import re
import argparse
from datetime import datetime, timezone
from collections import defaultdict

try:
    import requests
except ImportError:
    print("Error: requests is required. Install with: pip install requests", file=sys.stderr)
    sys.exit(1)

OUTPUT_DIR = "{{ docloader_data_dir }}/packages"
OUTPUT_FILE = os.path.join(OUTPUT_DIR, "pgedge-packages.md")

# Base repository URLs
APT_BASE_URL = "https://apt.pgedge.com"
DNF_BASE_URL = "https://dnf.pgedge.com"

# Mapping of codenames to friendly names
DEBIAN_CODENAMES = {
    'bullseye': 'Debian 11 (Bullseye)',
    'bookworm': 'Debian 12 (Bookworm)',
    'trixie': 'Debian 13 (Trixie)',
    'forky': 'Debian 14 (Forky)',
}

UBUNTU_CODENAMES = {
    'focal': 'Ubuntu 20.04 (Focal)',
    'jammy': 'Ubuntu 22.04 (Jammy)',
    'mantic': 'Ubuntu 23.10 (Mantic)',
    'noble': 'Ubuntu 24.04 (Noble)',
    'oracular': 'Ubuntu 24.10 (Oracular)',
    'plucky': 'Ubuntu 25.04 (Plucky)',
}

EL_VERSIONS = {
    'el7': 'RHEL/Rocky/Alma 7',
    'el8': 'RHEL/Rocky/Alma 8',
    'el9': 'RHEL/Rocky/Alma 9',
    'el10': 'RHEL/Rocky/Alma 10',
}


def discover_apt_distributions() -> dict:
    """
    Discover available distributions from the apt repository.
    Checks known Debian/Ubuntu codenames to see which ones have packages.
    Returns dict of {key: {'name': friendly_name, 'url': packages_url}}
    """
    distributions = {}

    # Check all known codenames
    all_codenames = {}
    for codename, friendly_name in DEBIAN_CODENAMES.items():
        all_codenames[codename] = ('debian', friendly_name)
    for codename, friendly_name in UBUNTU_CODENAMES.items():
        all_codenames[codename] = ('ubuntu', friendly_name)

    for codename, (distro_type, friendly_name) in all_codenames.items():
        # URL structure: https://apt.pgedge.com/release/{codename}/dists/{codename}/main/binary-amd64/Packages
        packages_url = f"{APT_BASE_URL}/release/{codename}/dists/{codename}/main/binary-amd64/Packages"
        try:
            # Check if packages exist (try gzipped first)
            check_response = requests.head(packages_url + '.gz', timeout=10)
            if check_response.status_code != 200:
                check_response = requests.head(packages_url, timeout=10)
                if check_response.status_code != 200:
                    continue

            key = f"{distro_type}_{codename}"
            distributions[key] = {
                'name': friendly_name,
                'url': packages_url,
                'codename': codename,
            }
        except Exception:
            continue

    return distributions


def discover_dnf_distributions() -> dict:
    """
    Discover available distributions from the dnf repository.
    Returns dict of {key: {'name': friendly_name, 'baseurl': repo_url}}
    """
    distributions = {}

    # Check for known EL versions
    # URL structure: https://dnf.pgedge.com/release/{version}/RPMS/x86_64/repodata/repomd.xml
    # where {version} is just the major version number (e.g., "9" not "el9")
    for el_key, friendly_name in EL_VERSIONS.items():
        # Extract just the version number from "el9" -> "9"
        version_num = el_key.replace('el', '')
        baseurl = f"{DNF_BASE_URL}/release/{version_num}/RPMS/x86_64/"
        try:
            # Check if repodata exists
            response = requests.head(f"{baseurl}repodata/repomd.xml", timeout=10)
            if response.status_code == 200:
                distributions[el_key] = {
                    'name': friendly_name,
                    'baseurl': baseurl,
                }
        except Exception:
            continue

    return distributions


def fetch_apt_packages(url: str) -> list[dict]:
    """Fetch and parse an apt Packages file."""
    try:
        # Try gzipped first
        response = requests.get(url + '.gz', timeout=30)
        if response.status_code == 200:
            import gzip
            content = gzip.decompress(response.content).decode('utf-8')
        else:
            # Try uncompressed
            response = requests.get(url, timeout=30)
            if response.status_code != 200:
                return []
            content = response.text
    except Exception as e:
        print(f"  Warning: Failed to fetch {url}: {e}", file=sys.stderr)
        return []

    packages = []
    current = {}

    for line in content.split('\n'):
        if line.startswith('Package:'):
            if current:
                packages.append(current)
            current = {'name': line.split(':', 1)[1].strip()}
        elif line.startswith('Version:') and current:
            current['version'] = line.split(':', 1)[1].strip()
        elif line.startswith('Description:') and current:
            current['description'] = line.split(':', 1)[1].strip()

    if current:
        packages.append(current)

    return packages


def fetch_dnf_packages(baseurl: str) -> list[dict]:
    """Fetch package list from a DNF repository."""
    try:
        import gzip
        import xml.etree.ElementTree as ET

        # Fetch repomd.xml
        repomd_url = baseurl.rstrip('/') + '/repodata/repomd.xml'
        response = requests.get(repomd_url, timeout=30)
        if response.status_code != 200:
            return []

        # Parse repomd.xml to find primary.xml.gz location
        root = ET.fromstring(response.content)
        ns = {'repo': 'http://linux.duke.edu/metadata/repo'}

        primary_href = None
        for data in root.findall('repo:data', ns):
            if data.get('type') == 'primary':
                location = data.find('repo:location', ns)
                if location is not None:
                    primary_href = location.get('href')
                    break

        if not primary_href:
            return []

        # Fetch primary.xml.gz
        primary_url = baseurl.rstrip('/') + '/' + primary_href
        response = requests.get(primary_url, timeout=60)
        if response.status_code != 200:
            return []

        # Decompress and parse
        if primary_href.endswith('.gz'):
            content = gzip.decompress(response.content)
        else:
            content = response.content

        root = ET.fromstring(content)
        ns = {'common': 'http://linux.duke.edu/metadata/common'}

        packages = []
        for pkg in root.findall('common:package', ns):
            if pkg.get('type') != 'rpm':
                continue

            name_el = pkg.find('common:name', ns)
            version_el = pkg.find('common:version', ns)
            summary_el = pkg.find('common:summary', ns)

            if name_el is not None:
                pkg_info = {'name': name_el.text}
                if version_el is not None:
                    ver = version_el.get('ver', '')
                    rel = version_el.get('rel', '')
                    pkg_info['version'] = f"{ver}-{rel}" if rel else ver
                if summary_el is not None:
                    pkg_info['description'] = summary_el.text
                packages.append(pkg_info)

        return packages

    except Exception as e:
        print(f"  Warning: Failed to fetch DNF repo {baseurl}: {e}", file=sys.stderr)
        return []


def categorize_package(name: str) -> tuple[str, str, str]:
    """
    Categorize a package by type.
    Returns: (category, pg_version, component_name)
    """
    # PostgreSQL server packages
    if re.match(r'^pgedge-enterprise-postgres[-_](\d+)$', name):
        match = re.match(r'^pgedge-enterprise-postgres[-_](\d+)$', name)
        return ('server', match.group(1), 'PostgreSQL Server')

    if re.match(r'^pgedge-enterprise-all[-_](\d+)$', name):
        match = re.match(r'^pgedge-enterprise-all[-_](\d+)$', name)
        return ('bundle', match.group(1), 'Full Bundle')

    # Extension packages
    ext_match = re.match(r'^pgedge-postgresql-(\d+)-(.+)$', name)
    if ext_match:
        pg_ver = ext_match.group(1)
        component = ext_match.group(2)
        return ('extension', pg_ver, component)

    # Other pgEdge packages
    if name.startswith('pgedge-'):
        return ('tool', '', name.replace('pgedge-', ''))

    return ('other', '', name)


def generate_markdown(all_packages: dict, apt_repos: dict, dnf_repos: dict) -> str:
    """Generate markdown documentation from package data."""
    lines = [
        "# pgEdge Enterprise Postgres Package Availability",
        "",
        "This document lists all packages available from the pgEdge repositories.",
        "Use this information to find the correct package names for your platform.",
        "",
        f"*Last updated: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}*",
        "",
    ]

    # Organize by PostgreSQL version
    pg_versions = set()
    for platform, packages in all_packages.items():
        for pkg in packages:
            cat, pg_ver, _ = categorize_package(pkg['name'])
            if pg_ver:
                pg_versions.add(pg_ver)

    pg_versions = sorted(pg_versions, reverse=True)

    # Platform summary
    lines.extend([
        "## Supported Platforms",
        "",
        "pgEdge Enterprise Postgres packages are available for:",
        "",
        "### Debian/Ubuntu (apt)",
        "",
    ])
    for key in sorted(apt_repos.keys()):
        lines.append(f"- {apt_repos[key]['name']}")
    lines.append("")

    lines.extend([
        "### RHEL/Rocky/AlmaLinux (dnf)",
        "",
    ])
    # List EL versions - use discovered repos if available, otherwise list known versions
    if dnf_repos:
        for key in sorted(dnf_repos.keys()):
            lines.append(f"- {dnf_repos[key]['name']}")
    else:
        # DNF repos not directly accessible, list known supported versions
        for key in sorted(EL_VERSIONS.keys()):
            lines.append(f"- {EL_VERSIONS[key]}")
    lines.append("")

    lines.extend([
        "**Note:** pgEdge Enterprise Postgres is NOT available for SUSE, Arch Linux,",
        "FreeBSD, macOS, Windows, or other platforms not listed above.",
        "",
    ])

    # If DNF repos not accessible, add note about package naming
    if not dnf_repos and apt_repos:
        lines.extend([
            "**Package Naming Convention:**",
            "- Debian/Ubuntu packages use dashes: `pgedge-enterprise-postgres-18`",
            "- EL (RHEL/Rocky/Alma) packages use underscores: `pgedge-enterprise-postgres_18`",
            "",
        ])

    # Helper to get platform name
    def get_platform_name(key):
        if key in apt_repos:
            return apt_repos[key]['name']
        if key in dnf_repos:
            return dnf_repos[key]['name']
        return key

    # Server packages by version
    for pg_ver in pg_versions:
        lines.extend([
            f"## PostgreSQL {pg_ver}",
            "",
            "### Base Installation Packages",
            "",
            "| Platform | Server Package | Full Bundle |",
            "|----------|---------------|-------------|",
        ])

        for platform in sorted(all_packages.keys()):
            packages = all_packages[platform]
            platform_name = get_platform_name(platform)
            pkg_names = {pkg['name'] for pkg in packages}

            # Find server and bundle packages
            server_pkg = None
            bundle_pkg = None

            for pkg_name in pkg_names:
                if re.match(rf'^pgedge-enterprise-postgres[-_]{pg_ver}$', pkg_name):
                    server_pkg = pkg_name
                elif re.match(rf'^pgedge-enterprise-all[-_]{pg_ver}$', pkg_name):
                    bundle_pkg = pkg_name

            if server_pkg or bundle_pkg:
                lines.append(f"| {platform_name} | `{server_pkg or 'N/A'}` | `{bundle_pkg or 'N/A'}` |")

        lines.append("")

        # Extensions for this PG version
        extensions = defaultdict(dict)  # component -> platform -> package_name

        for platform, packages in all_packages.items():
            for pkg in packages:
                cat, ver, component = categorize_package(pkg['name'])
                if cat == 'extension' and ver == pg_ver:
                    extensions[component][platform] = pkg['name']

        if extensions:
            lines.extend([
                f"### Extensions for PostgreSQL {pg_ver}",
                "",
            ])

            # Create extension table
            platforms = sorted(all_packages.keys())
            header = "| Extension | " + " | ".join(
                get_platform_name(p)[:12]
                for p in platforms
            ) + " |"
            separator = "|-----------|" + "|".join("-" * 13 for _ in platforms) + "|"

            lines.append(header)
            lines.append(separator)

            for component in sorted(extensions.keys()):
                row = f"| {component} |"
                for platform in platforms:
                    pkg = extensions[component].get(platform)
                    row += f" {'✓' if pkg else ''} |"
                lines.append(row)

            lines.append("")

            # List actual package names
            lines.extend([
                f"#### Extension Package Names (PostgreSQL {pg_ver})",
                "",
            ])

            for component in sorted(extensions.keys()):
                # Get a sample package name (they should be similar across platforms)
                sample = list(extensions[component].values())[0] if extensions[component] else None
                if sample:
                    lines.append(f"- **{component}**: `{sample}`")

            lines.append("")

    # Additional tools
    tools = set()
    for platform, packages in all_packages.items():
        for pkg in packages:
            cat, _, name = categorize_package(pkg['name'])
            if cat == 'tool':
                tools.add((pkg['name'], pkg.get('description', '')))

    if tools:
        lines.extend([
            "## Additional Tools",
            "",
        ])
        for name, desc in sorted(tools):
            lines.append(f"- `{name}`: {desc}" if desc else f"- `{name}`")
        lines.append("")

    # Installation instructions
    lines.extend([
        "## Installation Instructions",
        "",
        "### Debian/Ubuntu",
        "",
        "1. Set up the pgEdge repository (see repository setup documentation)",
        "2. Install packages with apt:",
        "   ```bash",
        "   sudo apt-get update",
        "   sudo apt-get install pgedge-enterprise-postgres-18",
        "   ```",
        "",
        "### RHEL/Rocky/AlmaLinux",
        "",
        "1. Set up the pgEdge repository (see repository setup documentation)",
        "2. Install packages with dnf:",
        "   ```bash",
        "   sudo dnf install pgedge-enterprise-postgres_18",
        "   ```",
        "",
        "**Note:** Package names use dashes (`-`) on Debian/Ubuntu and underscores (`_`) on EL platforms.",
        "",
    ])

    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(
        description='Scan pgEdge repositories and generate package documentation',
    )
    parser.add_argument('--dry-run', '-n', action='store_true',
                        help='Show what would be generated without writing files')
    parser.add_argument('--output', '-o', default=OUTPUT_FILE,
                        help=f'Output file path (default: {OUTPUT_FILE})')

    args = parser.parse_args()

    print("Scanning pgEdge repositories for available packages...")

    # Discover available distributions
    print("\nDiscovering APT distributions...")
    apt_repos = discover_apt_distributions()
    print(f"  Found: {', '.join(sorted(apt_repos.keys())) or 'none'}")

    print("\nDiscovering DNF distributions...")
    dnf_repos = discover_dnf_distributions()
    print(f"  Found: {', '.join(sorted(dnf_repos.keys())) or 'none (will use known EL versions)'}")

    if not apt_repos and not dnf_repos:
        print("\nError: No repositories found. Check network connectivity.", file=sys.stderr)
        sys.exit(1)

    all_packages = {}

    # Scan APT repositories
    if apt_repos:
        print("\nScanning APT repositories:")
        for key in sorted(apt_repos.keys()):
            info = apt_repos[key]
            print(f"  {info['name']}...", end=' ', flush=True)
            packages = fetch_apt_packages(info['url'])
            # Filter to pgEdge packages only
            packages = [p for p in packages if p['name'].startswith('pgedge-')]
            all_packages[key] = packages
            print(f"{len(packages)} packages")

    # Scan DNF repositories
    if dnf_repos:
        print("\nScanning DNF repositories:")
        for key in sorted(dnf_repos.keys()):
            info = dnf_repos[key]
            print(f"  {info['name']}...", end=' ', flush=True)
            packages = fetch_dnf_packages(info['baseurl'])
            # Filter to pgEdge packages only
            packages = [p for p in packages if p['name'].startswith('pgedge-')]
            all_packages[key] = packages
            print(f"{len(packages)} packages")

    # Generate markdown
    print("\nGenerating package documentation...")
    markdown = generate_markdown(all_packages, apt_repos, dnf_repos)

    if args.dry_run:
        print("\n--- Generated Markdown (dry run) ---\n")
        print(markdown[:2000])
        if len(markdown) > 2000:
            print(f"\n... ({len(markdown) - 2000} more characters)")
        return

    # Write output
    output_dir = os.path.dirname(args.output)
    os.makedirs(output_dir, exist_ok=True)

    with open(args.output, 'w') as f:
        f.write(markdown)

    print(f"\nGenerated: {args.output}")
    print(f"Total size: {len(markdown)} bytes")


if __name__ == '__main__':
    main()
